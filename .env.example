PORT=3000
APP_URL=https://www.sitetrace.it.com

# Public scan limits
RATE_LIMIT=20
RATE_LIMIT_WINDOW_MS=3600000
API_TIMEOUT_MS=12000
MAX_BODY_BYTES=2097152

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# Scheduled checks
CRON_SECRET=

# Optional email alerts through Resend
RESEND_API_KEY=
# Optional read-capable Resend key for delivery diagnostics
RESEND_READ_API_KEY=
ALERT_FROM_EMAIL=SiteTrace <alerts@sitetrace.it.com>

# Optional chat alerts through incoming webhooks
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
